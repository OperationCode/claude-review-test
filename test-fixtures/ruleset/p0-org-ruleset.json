{
  "name": "p0-required-workflow",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": { "include": ["refs/heads/p0-base"], "exclude": [] },
    "repository_id": { "repository_ids": [1432457406] }
  },
  "rules": [
    {
      "type": "workflows",
      "parameters": {
        "do_not_enforce_on_create": false,
        "workflows": [
          { "repository_id": 0, "path": ".github/workflows/p0-required.yml", "sha": "REPLACE_WITH_40_CHAR_COMMIT_SHA" }
